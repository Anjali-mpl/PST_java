\pard\sa200\sl276\slmult1\f0\fs22\lang9 import java.util.*;\par
\par
class Student\{\par
    private int id;\par
    private String fname;\par
    private double cgpa;\par
\par
    public Student(int id, String fname, double cgpa) \{\par
        super();\par
        this.id = id;\par
        this.fname = fname;\par
        this.cgpa = cgpa;\par
    \}\par
\par
    public int getId() \{\par
        return id;\par
    \}\par
\par
    public String getFname() \{\par
        return fname;\par
    \}\par
\par
    public double getCgpa() \{\par
        return cgpa;\par
    \}\par
\}\par
\par
public class Solution2\par
\{\par
    public static void main(String[] args)\{\par
        Scanner in = new Scanner(System.in);\par
        int testCases = Integer.parseInt(in.nextLine());\par
\par
        List<Student> studentList = new ArrayList<Student>();\par
\par
        while(testCases > 0)\{\par
            int id = in.nextInt();\par
            String fname = in.next();\par
            double cgpa = in.nextDouble();\par
\par
            Student st = new Student(id, fname, cgpa);\par
            studentList.add(st);\par
\par
            testCases--;\par
        \}\par
\par
        Collections.sort(studentList, new Comparator<Student>() \{\par
            public int compare(Student s1, Student s2) \{\par
\par
                if(s1.getCgpa() < s2.getCgpa())\par
                    return 1;\par
\par
                if(s1.getCgpa() > s2.getCgpa())\par
                    return -1;\par
\par
                int name = s1.getFname().compareTo(s2.getFname());\par
\par
                if(name != 0)\par
                    return name;\par
\par
                return Integer.compare(s1.getId(), s2.getId());\par
            \}\par
        \});\par
\par
        for(Student st: studentList)\{\par
            System.out.println(st.getFname());\par
        \}\par
    \}\par
\}\par

